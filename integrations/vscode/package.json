{
  "name": "codex-account-switcher-bridge",
  "displayName": "Codex Roster — Experimental Integration",
  "description": "Optional local integration for Codex Roster. Requires explicit enablement.",
  "version": "0.1.0",
  "publisher": "local-account-switcher",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "contributes": {
    "commands": [
      { "command": "codexAccountSwitcher.enableIntegration", "title": "Codex Roster: Enable Experimental Integration" },
      { "command": "codexAccountSwitcher.disableIntegration", "title": "Codex Roster: Disable Experimental Integration" }
    ]
  }
}
