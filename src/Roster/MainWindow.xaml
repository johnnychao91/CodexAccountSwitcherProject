<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:roster="clr-namespace:CodexAccountSwitcher;assembly=CodexRoster" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Codex Roster" Width="1120" Height="1160" MinWidth="1040" MinHeight="710" WindowStartupLocation="CenterScreen" Background="{x:Static roster:RosterTheme.Cream}" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="14" Foreground="{x:Static roster:RosterTheme.Ink}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{x:Static roster:RosterTheme.Primary}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="6">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{x:Static roster:RosterTheme.Cream}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{x:Static roster:RosterTheme.Surface}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{x:Static roster:RosterTheme.SoftGold}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="ToolTip" Value="最大化"/><Setter Property="AutomationProperties.Name" Value="最大化"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
          <Setter Property="ToolTip" Value="還原大小"/><Setter Property="AutomationProperties.Name" Value="還原大小"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{x:Static roster:RosterTheme.Warning}"/><Setter Property="Foreground" Value="White"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{x:Static roster:RosterTheme.Ink}"/><Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{x:Static roster:RosterTheme.Surface}"/><Setter Property="Foreground" Value="{x:Static roster:RosterTheme.Ink}"/>
      <Setter Property="Padding" Value="17,11"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{x:Static roster:RosterTheme.SoftGold}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="{x:Static roster:RosterTheme.Surface}" BorderBrush="{x:Static roster:RosterTheme.SoftGold}" BorderThickness="1" CornerRadius="12" Padding="20,16"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{x:Static roster:RosterTheme.Primary}"/><Setter TargetName="B" Property="Background" Value="{x:Static roster:RosterTheme.Mist}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{x:Static roster:RosterTheme.Lavender}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="1" IsHitTestVisible="False" BorderBrush="{x:Static roster:RosterTheme.SoftGold}">
      <Border.Style><Style TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/>
          </DataTrigger>
        </Style.Triggers>
      </Style></Border.Style>
    </Border>
    <Border x:Name="RosterTitleBar" Grid.ColumnSpan="2" Background="{x:Static roster:RosterTheme.Mist}" BorderBrush="{x:Static roster:RosterTheme.SoftGold}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,6,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Width="18" Height="18" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" VerticalAlignment="Center" Foreground="{x:Static roster:RosterTheme.Primary}" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CaptionMinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化">
              <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.2" Data="M 1,7 L 11,7"/>
            </Button>
            <Button x:Name="CaptionMaximizeButton" Style="{StaticResource MaximizeCaptionButton}">
              <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.2">
                <Path.Style><Style TargetType="Path">
                  <Setter Property="Data" Value="M 1.5,1.5 H 10.5 V 10.5 H 1.5 Z"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                      <Setter Property="Data" Value="M 1.5,4 H 8.5 V 10.5 H 1.5 Z M 4,4 V 1.5 H 11 V 8.5 H 8.5"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style></Path.Style>
              </Path>
            </Button>
            <Button x:Name="CaptionCloseButton" Style="{StaticResource CloseCaptionButton}" ToolTip="關閉" AutomationProperties.Name="關閉">
              <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.2" Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
            </Button>
          </StackPanel>
        </Grid>
    </Border>
    <Border Grid.Row="1" Background="{x:Static roster:RosterTheme.Mist}" BorderBrush="{x:Static roster:RosterTheme.SoftGold}" BorderThickness="0,0,1,0">
      <Grid Margin="26,34,22,27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Image x:Name="RosterLogo" Width="142" Height="142" Margin="0,0,0,18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Codex Roster"/>
          <Border Background="{x:Static roster:RosterTheme.Primary}" CornerRadius="9" Padding="14,13"><TextBlock Text="我的帳號" Foreground="White" FontWeight="SemiBold"/></Border>
          <TextBlock x:Name="AccountCount" Text="0 個已儲存帳號" Foreground="{x:Static roster:RosterTheme.Muted}" Margin="14,14,0,0" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="只在這台電腦保存" Foreground="{x:Static roster:RosterTheme.Primary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="使用 Windows 使用者加密，&#10;不需要提供密碼給本工具。" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="12" LineHeight="22" TextWrapping="Wrap"/>
          <Border Height="1" Background="{x:Static roster:RosterTheme.Gold}" Margin="0,21,0,16"/>
          <TextBlock Text="v1.6.22" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" Margin="32,31,32,25">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="帳號管理" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button x:Name="AddButton" Grid.Column="1" Content="＋ 新增帳號" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" Background="{x:Static roster:RosterTheme.Primary}" Foreground="White" BorderBrush="{x:Static roster:RosterTheme.Primary}"/>
      </Grid>
      <Border Grid.Row="1" Background="{x:Static roster:RosterTheme.Surface}" BorderBrush="{x:Static roster:RosterTheme.SoftGold}" BorderThickness="1" CornerRadius="14" Padding="23,19" Margin="0,0,0,24">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="目前的本機登入" FontSize="12" Foreground="{x:Static roster:RosterTheme.Muted}" Margin="0,0,0,8"/>
            <TextBlock x:Name="CurrentName" Text="讀取中…" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="CurrentDetail" Text="" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <Button x:Name="SaveButton" Grid.Column="1" Content="儲存目前帳號" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="已儲存帳號" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UsageButton" Content="更新帳號與額度" Padding="11,7" Margin="0,0,8,0"/>
          <Button x:Name="RenameButton" Content="重新命名" Padding="11,7" Margin="0,0,8,0"/>
          <Button x:Name="RemoveButton" Content="移除" Padding="11,7"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="PriorityHint" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="MoveUpButton" Content="↑ 上移" Padding="11,7" Margin="0,0,8,0" ToolTip="提高所選帳號的優先順序"/>
            <Button x:Name="MoveDownButton" Content="↓ 下移" Padding="11,7" Margin="0,0,8,0" ToolTip="降低所選帳號的優先順序"/>
            <Button x:Name="SelectPriorityButton" Content="選取優先可用帳號" Padding="11,7" ToolTip="依排序選取有新鮮可用額度的帳號；不會自動切換登入"/>
          </StackPanel>
        </Grid>
      </Grid>
      <Grid Grid.Row="3">
        <ListBox x:Name="AccountList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{x:Static roster:RosterTheme.Mist}" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Static roster:RosterTheme.Primary}" FontWeight="SemiBold"/></Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Workspace}" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                <TextBlock Text="{Binding PriorityText}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Status}" Foreground="{x:Static roster:RosterTheme.Primary}" FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Saved}" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Right"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{x:Static roster:RosterTheme.Mist}" CornerRadius="8" Padding="12,10">
                  <StackPanel>
                    <Grid><TextBlock Text="5 小時上限" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding FiveHourText}" HorizontalAlignment="Right" FontSize="12" Foreground="{x:Static roster:RosterTheme.Primary}"/></Grid>
                    <ProgressBar Value="{Binding FiveHourValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="5" Margin="0,9,0,6" Foreground="{x:Static roster:RosterTheme.Primary}" Background="{x:Static roster:RosterTheme.Surface}" BorderThickness="0" Visibility="{Binding FiveHourAvailable, Converter={StaticResource VisibleWhenTrue}}"/>
                    <TextBlock Text="{Binding FiveHourReset}" FontSize="10" Foreground="{x:Static roster:RosterTheme.Muted}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{x:Static roster:RosterTheme.Mist}" CornerRadius="8" Padding="12,10">
                  <StackPanel>
                    <Grid><TextBlock Text="每週上限" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding WeeklyText}" HorizontalAlignment="Right" FontSize="12" Foreground="{x:Static roster:RosterTheme.Primary}"/></Grid>
                    <ProgressBar Value="{Binding WeeklyValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="5" Margin="0,9,0,6" Foreground="{x:Static roster:RosterTheme.Primary}" Background="{x:Static roster:RosterTheme.Surface}" BorderThickness="0" Visibility="{Binding WeeklyAvailable, Converter={StaticResource VisibleWhenTrue}}"/>
                    <TextBlock Text="{Binding WeeklyReset}" FontSize="10" Foreground="{x:Static roster:RosterTheme.Muted}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding AvailabilityText}" Foreground="{Binding AvailabilityBrush}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding UsageNote}" FontSize="11" Foreground="{x:Static roster:RosterTheme.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
          <TextBlock Text="先收藏你的第一個帳號" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="按「儲存目前帳號」，或新增另一個 ChatGPT 登入。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{x:Static roster:RosterTheme.Muted}" Margin="0,12,0,16"/>
          <TextBlock Text="每個帳號只需先登入一次。" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="4" Background="{x:Static roster:RosterTheme.Mist}" CornerRadius="10" Padding="16,13" Margin="0,16,0,18">
        <StackPanel>
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="MonitorCheck" Content="自動切換帳號" ToolTip="每 60 秒查詢額度" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold"/>
            <Button x:Name="DesktopControlButton" Grid.Column="1" Content="桌面控制…" Padding="10,6"/>
          </Grid>
          <TextBlock x:Name="ContinuationStatusText" Visibility="Collapsed" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBlock x:Name="AutoStatus" Foreground="{x:Static roster:RosterTheme.Muted}" FontSize="12" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="StatusText" Text="準備就緒。選擇帳號後即可切換。" TextWrapping="Wrap" Foreground="{x:Static roster:RosterTheme.Ink}" LineHeight="22"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" x:Name="ProgressActions" Visibility="Collapsed">
            <Button x:Name="CancelButton" Content="取消" Padding="12,6"/>
            <Button x:Name="BrowserButton" Content="重新開啟登入網頁" Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <Expander x:Name="AdvancedOptions" Header="進階選項" Foreground="{x:Static roster:RosterTheme.Primary}" FontSize="12" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="ContinueDesktopButton" Content="開啟自動續跑" Padding="10,6" Margin="0,0,10,0"/>
                <TextBlock x:Name="ContinuationModeText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </Grid>
              <CheckBox x:Name="InterruptCheck" Content="切換時允許正常中止 VS Code 的 Codex 回合" ToolTip="僅限已整合的 VS Code" Margin="0,0,0,9"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="RuntimeButton" Content="檢查工作狀態" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="IntegrationButton" Content="VS Code 整合…" Padding="10,6"/>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="DesktopControlStatusText" Text="正在檢查桌面連線…" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="OpenAppButton" Content="開啟 Codex" Margin="0,0,2,0"/>
          <Button x:Name="RestoreButton" Content="切回上一個" Margin="8,0,10,0"/>
          <Button x:Name="SwitchButton" Content="切換並開啟 Codex  →" Background="{x:Static roster:RosterTheme.Primary}" BorderBrush="{x:Static roster:RosterTheme.Primary}" Foreground="White"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
